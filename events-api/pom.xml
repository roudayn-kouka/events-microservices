<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tn.fst.events</groupId>
        <artifactId>events-microservices</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>events-api</artifactId>
    <name>events-api</name>
    <description>Contrats des événements métier publiés dans Axon (CQRS) : records Java, sans dépendance</description>

    <!--
      Seuls les ÉVÉNEMENTS sont partagés : ils traversent les services (publiés par event, participant,
      logistics et feedback ; consommés par statistics). Les commandes et les requêtes restent internes
      au service qui les traite. Aucune dépendance : pas de Spring, pas d'Axon, pas de JPA.
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- test de contrat JSON uniquement (Jackson + dates ISO, comme le sérialiseur Axon) -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
