{
  "uid": "events-resilience4j",
  "title": "Events — Resilience4j",
  "description": "Circuits, Retry, RateLimiter et TimeLimiter des appels Feign (make panne N=1..5)",
  "tags": [
    "events-fst"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Circuits ouverts",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(resilience4j_circuitbreaker_state{state=\"open\"}) or vector(0)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Circuits mi-ouverts (HALF_OPEN)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(resilience4j_circuitbreaker_state{state=\"half_open\"}) or vector(0)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "État de chaque circuit (1 = état actuel)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (application, name, state) (resilience4j_circuitbreaker_state) == 1",
          "legendFormat": "",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Circuit OUVERT (1) au fil du temps",
      "description": "1 : OPEN ; 0,5 : HALF_OPEN ; 0 : CLOSED",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (application, name) (resilience4j_circuitbreaker_state{state=\"open\"})",
          "legendFormat": "{{application}} → {{name}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max by (application, name) (resilience4j_circuitbreaker_state{state=\"half_open\"}) * 0.5",
          "legendFormat": "{{application}} → {{name}} (HALF_OPEN)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Taux d'échec des circuits (%)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (application, name) (resilience4j_circuitbreaker_failure_rate)",
          "legendFormat": "{{application}} → {{name}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Appels par résultat (CircuitBreaker)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (name, kind) (rate(resilience4j_circuitbreaker_calls_seconds_count[1m]))",
          "legendFormat": "{{name}} {{kind}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Appels refusés (circuit ouvert)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (application, name) (rate(resilience4j_circuitbreaker_not_permitted_calls_total[1m]))",
          "legendFormat": "{{application}} → {{name}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Retry : appels par résultat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (name, kind) (rate(resilience4j_retry_calls_total[1m]))",
          "legendFormat": "{{name}} {{kind}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "TimeLimiter : appels par résultat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (name, kind) (rate(resilience4j_timelimiter_calls_total[1m]))",
          "legendFormat": "{{name}} {{kind}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Appels Feign : durée moyenne par client",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (application, clientName) (rate(feign_client_requests_seconds_sum[1m])) / sum by (application, clientName) (rate(feign_client_requests_seconds_count[1m]))",
          "legendFormat": "{{application}} → {{clientName}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "RateLimiter : autorisations disponibles (5 / s)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "min by (application, name) (resilience4j_ratelimiter_available_permissions)",
          "legendFormat": "{{application}} → {{name}}"
        }
      ]
    }
  ]
}
