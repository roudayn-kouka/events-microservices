# =============================================================================
#  Modèle de configuration locale. NE CONTIENT AUCUN SECRET.
#  Générer le vrai fichier .env (ignoré par Git), avec des mots de passe aléatoires :
#     make env        (ou : bash scripts/init-env.sh)
# =============================================================================

# MySQL : compte administrateur et un mot de passe par service
MYSQL_ROOT_PASSWORD=change-me
EVENT_DB_PASSWORD=change-me
PARTICIPANT_DB_PASSWORD=change-me
LOGISTICS_DB_PASSWORD=change-me
FEEDBACK_DB_PASSWORD=change-me
STATS_DB_PASSWORD=change-me

# Keycloak (retiré du périmètre, base db_keycloak conservée) et Grafana (phase 6)
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# Branche Git lue par le Config Server (dossier config-repo/). « make up » la remplit
# automatiquement avec la branche courante ; valeur par défaut : develop.
CONFIG_GIT_LABEL=develop

# Origines autorisées en CORS par la Gateway (frontend Angular)
FRONTEND_ORIGINS=http://localhost:4200
