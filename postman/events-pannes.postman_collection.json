          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 503', () => pm.response.to.have.status(503));",
                  "pm.test('Composant db DOWN', () => pm.expect(pm.response.json().components.db.status).to.eql('DOWN'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{participantActuator}}/health"
          }
        },
